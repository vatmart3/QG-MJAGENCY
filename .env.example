# --- Supabase (Phase 2) ---
# Laisser vide = mode DÉMO (tout en local). Remplir = connexion par lien magique + temps réel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : crée les comptes de l'allowlist (permet de fermer les inscriptions publiques)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 3) ---
# Sans clé : le moteur tourne en mode simulé (scénario réaliste, livrables marqués « simulé »)
ANTHROPIC_API_KEY=
MODEL_PLANNER=claude-opus-5-5
MODEL_WORKER=claude-sonnet-5-5
MODEL_LIGHT=claude-haiku-5-5

# --- Google (Phase 4 & 7) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# --- Sécurité ---
ENCRYPTION_KEY=          # 32 octets base64 : openssl rand -base64 32
CRON_SECRET=

# --- App ---
APP_URL=http://localhost:3000
# Allowlist de secours ; la référence est la table settings (éditable dans Réglages)
ALLOWED_EMAILS=jeremyvatuonepro@gmail.com,mjagency.officiel@gmail.com
AGENCY_MAILBOX=mjagency.officiel@gmail.com

# --- Shopify (Phase 8) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Budget ---
DAILY_BUDGET_EUR=3

# « true » force le moteur simulé même si ANTHROPIC_API_KEY est renseignée (tests sans dépense)
MOCK_MODE=

# --- Moteur d'agents (optionnel) ---
ENGINE_STEPS_PER_TICK=8        # pas d'agents max par appel à /api/engine/tick
ENGINE_PARALLEL=3              # tâches traitées en parallèle
ENGINE_TICK_BUDGET_MS=40000    # temps max d'un tick (les fonctions Vercel s'arrêtent à 60 s)
ENGINE_MEETING_DELAY_MS=45000  # réunion de lancement dans La Criée avant les sous-tâches
